<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>班級早修小幫手 🎒</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        cream: '#FFFDF9',
                        warmYellow: '#FFE599',
                        pastelOrange: '#FFD1A4',
                        pastelGreen: '#C1E7E3',
                        pastelMint: '#B2EBF2',
                        pastelBlue: '#A2D2FF',
                        pastelPink: '#FFC8DD',
                        pastelPurple: '#CDB4DB',
                        pastelRed: '#FFB3BA',
                        softGray: '#F5F5F7',
                        slateText: '#4A4E69'
                    },
                    fontFamily: {
                        sans: ['Noto Sans TC', 'Fredoka', 'sans-serif'],
                        rounded: ['Fredoka', 'Noto Sans TC', 'sans-serif'],
                    },
                    boxShadow: {
                        'cute': '0 8px 0px 0px rgba(0, 0, 0, 0.06), 0 10px 15px -3px rgba(0, 0, 0, 0.1)',
                        'cute-sm': '0 4px 0px 0px rgba(0, 0, 0, 0.05)',
                        'cute-lg': '0 12px 0px 0px rgba(0, 0, 0, 0.08), 0 20px 25px -5px rgba(0, 0, 0, 0.1)',
                        'pressed': 'inset 0 4px 6px rgba(0,0,0,0.1)'
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #FFFDF9;
            background-image: radial-gradient(#E2ECE9 1.5px, transparent 1.5px);
            background-size: 24px 24px;
            font-family: 'Noto Sans TC', sans-serif;
            user-select: none;
            -webkit-user-select: none;
        }

        /* 自訂滾動條 */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #F0F4F8;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb {
            background: #FFC8DD;
            border-radius: 10px;
        }

        .pop-in {
            animation: popIn 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        @keyframes popIn {
            0% { transform: scale(0.85); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }

        .seat-btn {
            transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
            touch-action: manipulation;
        }
        .seat-btn:active {
            transform: translateY(3px) scale(0.96);
            box-shadow: 0 1px 0px 0px rgba(0,0,0,0.1);
        }

        .clock-font {
            font-family: 'Fredoka', 'Noto Sans TC', sans-serif;
            letter-spacing: 0.5px;
        }

        .no-flicker {
            transform: translateZ(0);
            backface-visibility: hidden;
        }
    </style>
</head>
<body class="h-screen w-screen overflow-hidden text-slateText flex flex-col justify-between p-3 md:p-4 select-none">

    <!-- 頂端欄：標題、大型即時時鐘、老師管理按鈕 -->
    <header class="w-full bg-white/95 backdrop-blur-md rounded-3xl p-3 px-6 shadow-cute border-2 border-amber-100 flex items-center justify-between z-10 shrink-0 mb-3">
        <!-- 班級名稱 -->
        <div class="flex items-center gap-3">
            <div class="bg-pastelOrange/40 text-amber-800 p-3 rounded-2xl flex items-center justify-center text-2xl shadow-inner">
                ☀️
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <h1 id="classNameDisplay" class="text-xl md:text-2xl font-black text-amber-900 tracking-wide">一年甲班</h1>
                    <span class="bg-amber-100 text-amber-800 text-xs px-2.5 py-1 rounded-full font-bold border border-amber-200">早修小幫手</span>
                </div>
                <p class="text-xs text-amber-700/80 font-bold mt-0.5">點選座號即可完成「到校打卡」與「打掃工作簽到」</p>
            </div>
        </div>

        <!-- 大型台灣即時時鐘 (獨立渲染) -->
        <div class="bg-gradient-to-r from-amber-50 to-orange-50 px-6 py-1.5 rounded-2xl border-2 border-amber-200/80 shadow-inner flex items-center gap-4">
            <div class="text-right">
                <div id="clockDate" class="text-xs md:text-sm font-bold text-amber-800/80">----年--月--日 (星期-)</div>
                <div id="clockTime" class="text-2xl md:text-3xl font-black text-amber-900 clock-font leading-tight">00:00:00</div>
            </div>
            <div class="hidden sm:flex flex-col text-[11px] font-bold text-amber-700/80 bg-white/80 px-2.5 py-1 rounded-xl border border-amber-100">
                <span>到校截止</span>
                <span id="deadlineDisplay" class="text-xs font-black text-rose-500">07:40</span>
            </div>
        </div>

        <!-- 老師管理按鈕 (無密碼) -->
        <button onclick="openSettingsModal()" class="group bg-gradient-to-r from-purple-100 to-pink-100 hover:from-purple-200 hover:to-pink-200 text-purple-900 font-bold px-4 py-2.5 rounded-2xl shadow-cute-sm hover:shadow-cute active:translate-y-0.5 border-2 border-purple-200 transition-all flex items-center gap-2">
            <i class="fa-solid fa-sliders text-purple-600 group-hover:rotate-45 transition-transform duration-300"></i>
            <span class="hidden md:inline">老師管理</span>
        </button>
    </header>

    <!-- 三欄佈局 -->
    <main class="w-full flex-1 grid grid-cols-12 gap-3 md:gap-4 min-h-0 overflow-hidden">

        <!-- 左側欄：【到校打卡】 -->
        <section class="col-span-12 md:col-span-3 lg:col-span-3 bg-white/85 rounded-3xl p-3.5 shadow-cute border-2 border-teal-100 flex flex-col justify-between min-h-0 overflow-hidden no-flicker">
            <!-- 上半部：統計資訊 -->
            <div class="flex flex-col shrink-0 mb-2">
                <div class="flex items-center justify-between mb-2 border-b-2 border-teal-50 pb-2">
                    <h2 class="text-base font-bold text-teal-800 flex items-center gap-1.5">
                        <span class="bg-teal-100 text-teal-700 w-7 h-7 rounded-xl flex items-center justify-center text-xs">📌</span>
                        到校打卡
                    </h2>
                    <span id="checkinStatusBadge" class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700 border border-emerald-200">
                        進行中
                    </span>
                </div>

                <div class="grid grid-cols-3 gap-1.5">
                    <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-1.5 text-center">
                        <div class="text-[10px] font-bold text-emerald-600">已打卡</div>
                        <div id="statCheckedIn" class="text-base font-black text-emerald-700 clock-font">0</div>
                    </div>
                    <div class="bg-rose-50 border border-rose-200 rounded-xl p-1.5 text-center">
                        <div class="text-[10px] font-bold text-rose-600">未打卡</div>
                        <div id="statUnchecked" class="text-base font-black text-rose-700 clock-font">0</div>
                    </div>
                    <div class="bg-sky-50 border border-sky-200 rounded-xl p-1.5 text-center">
                        <div class="text-[10px] font-bold text-sky-600">免打卡</div>
                        <div id="statExempt" class="text-base font-black text-sky-700 clock-font">0</div>
                    </div>
                </div>
            </div>

            <!-- 下半部：1-14 按鈕 (靠底對齊 Align to Bottom) -->
            <div class="flex-1 flex flex-col justify-end overflow-y-auto min-h-0 pr-1">
                <div id="morningSeatsGrid" class="grid grid-cols-3 gap-2">
                    <!-- JS 生成座號按鈕 -->
                </div>
            </div>
        </section>

        <!-- 中央欄：【聯絡簿】 (最大區域) -->
        <section class="col-span-12 md:col-span-6 lg:col-span-6 bg-white/90 rounded-3xl p-3.5 shadow-cute border-2 border-orange-100 flex flex-col min-h-0 relative no-flicker">
            <div class="flex items-center justify-between mb-2 border-b-2 border-orange-50 pb-2 shrink-0">
                <h2 class="text-base font-bold text-orange-900 flex items-center gap-1.5">
                    <span class="bg-orange-100 text-orange-700 w-7 h-7 rounded-xl flex items-center justify-center text-xs">📖</span>
                    今日聯絡簿
                </h2>
                
                <div class="flex items-center gap-1.5">
                    <button onclick="toggleHomeworkMask()" id="maskToggleBtn" class="bg-amber-100 hover:bg-amber-200 text-amber-800 text-xs font-bold px-2.5 py-1 rounded-xl border border-amber-300 transition-colors flex items-center gap-1 shadow-cute-sm">
                        <i class="fa-solid fa-eye-slash"></i>
                        <span id="maskBtnText">遮蔽聯絡簿</span>
                    </button>
                    <button onclick="openHomeworkModal()" class="bg-orange-100 hover:bg-orange-200 text-orange-800 text-xs font-bold px-2.5 py-1 rounded-xl border border-orange-300 transition-colors flex items-center gap-1 shadow-cute-sm">
                        <i class="fa-solid fa-expand"></i>
                        <span>全螢幕</span>
                    </button>
                </div>
            </div>

            <!-- Canva 聯絡簿容器 (16:9 比例完整呈現) -->
            <div class="flex-1 rounded-2xl overflow-hidden bg-slate-100 border-2 border-amber-200/80 relative flex items-center justify-center shadow-inner">
                <div class="w-full h-full relative flex items-center justify-center">
                    <iframe id="canvaFrame" 
                            src="https://www.canva.com/design/DAHZXg2jrYM/Fe8yVh4EbeHm4UMkCo8i-Q/view?embed" 
                            class="w-full h-full border-0 rounded-xl"
                            loading="lazy" 
                            allowfullscreen="allowfullscreen" 
                            allow="fullscreen">
                    </iframe>
                </div>

                <!-- 手動遮蔽罩 -->
                <div id="homeworkMask" class="hidden absolute inset-0 bg-gradient-to-br from-amber-100/98 to-orange-100/98 backdrop-blur-md flex-col items-center justify-center p-6 text-center z-20 pop-in">
                    <div class="text-5xl mb-2 animate-bounce">🙈</div>
                    <h3 class="text-xl font-black text-amber-900 mb-1">聯絡簿遮蔽中</h3>
                    <p class="text-amber-700/80 text-xs font-bold mb-3">請同學們先完成早修打卡與準備工作！</p>
                    <button onclick="toggleHomeworkMask()" class="bg-amber-500 hover:bg-amber-600 text-white font-bold px-5 py-2 rounded-xl shadow-cute transition-all transform active:scale-95 text-xs">
                        顯示聯絡簿 ✨
                    </button>
                </div>
            </div>
        </section>

        <!-- 右側欄：【打掃工作及中午時間】 -->
        <section class="col-span-12 md:col-span-3 lg:col-span-3 bg-white/85 rounded-3xl p-3.5 shadow-cute border-2 border-sky-100 flex flex-col justify-between min-h-0 overflow-hidden no-flicker">
            <!-- 上半部：資訊提示 -->
            <div class="flex flex-col shrink-0 mb-2">
                <div class="flex items-center justify-between mb-2 border-b-2 border-sky-50 pb-2">
                    <h2 class="text-base font-bold text-sky-900 flex items-center gap-1.5">
                        <span class="bg-sky-100 text-sky-700 w-7 h-7 rounded-xl flex items-center justify-center text-xs">🧹</span>
                        打掃及中午打卡
                    </h2>
                    <button onclick="resetTaskSeats()" class="text-[11px] font-bold text-sky-600 hover:text-sky-800 underline">
                        重置工作
                    </button>
                </div>

                <div class="bg-sky-50 border border-sky-200 rounded-xl p-2 flex items-center justify-between text-xs text-sky-800 font-bold">
                    <span>完成點擊座號：</span>
                    <span id="taskDoneCount" class="bg-sky-200 text-sky-900 px-2 py-0.5 rounded-md clock-font">0/14</span>
                </div>
            </div>

            <!-- 下半部：1-14 打掃按鈕 (靠底對齊 Align to Bottom) -->
            <div class="flex-1 flex flex-col justify-end overflow-y-auto min-h-0 pr-1">
                <div id="taskSeatsGrid" class="grid grid-cols-3 gap-2">
                    <!-- JS 生成工作座號按鈕 -->
                </div>
            </div>
        </section>

    </main>

    <!-- 老師管理彈窗 (無密碼) -->
    <div id="settingsModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl shadow-cute-lg border-4 border-purple-200 w-full max-w-xl max-h-[90vh] overflow-y-auto p-6 relative pop-in">
            <button onclick="closeSettingsModal()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 text-xl font-bold w-10 h-10 rounded-2xl bg-slate-100 flex items-center justify-center">
                ✕
            </button>

            <h2 class="text-xl font-black text-purple-900 mb-4 flex items-center gap-2">
                <i class="fa-solid fa-sliders text-purple-600"></i> 老師管理控制台
            </h2>

            <form id="settingsForm" onsubmit="saveSettings(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">班級名稱</label>
                    <input type="text" id="cfgClassName" class="w-full px-3 py-2 rounded-xl border-2 border-slate-200 focus:border-purple-400 focus:outline-none font-bold text-slate-800" value="一年甲班" required>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">學生人數 (預設 14)</label>
                        <input type="number" id="cfgStudentCount" min="1" max="60" class="w-full px-3 py-2 rounded-xl border-2 border-slate-200 focus:border-purple-400 focus:outline-none font-bold text-slate-800" value="14" required>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">排除/空號座號 (例如: 4, 12)</label>
                        <input type="text" id="cfgExcludedSeats" class="w-full px-3 py-2 rounded-xl border-2 border-slate-200 focus:border-purple-400 focus:outline-none font-bold text-slate-800" value="">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">早修到校打卡截止時間</label>
                    <input type="time" id="cfgDeadline" class="w-full px-3 py-2 rounded-xl border-2 border-slate-200 focus:border-purple-400 focus:outline-none font-bold text-slate-800" value="07:40" required>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">今日免打卡 / 請假學生座號</label>
                    <div id="exemptCheckboxContainer" class="grid grid-cols-7 gap-1.5 bg-slate-50 p-3 rounded-2xl border border-slate-200 max-h-36 overflow-y-auto text-xs">
                        <!-- JS 動態生成 -->
                    </div>
                </div>

                <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
                    <button type="button" onclick="resetTodayCheckins()" class="bg-rose-100 hover:bg-rose-200 text-rose-800 text-xs font-bold px-3 py-2 rounded-xl border border-rose-300 transition-colors flex items-center gap-1">
                        <i class="fa-solid fa-rotate-left"></i> 重置到校打卡
                    </button>
                    
                    <div class="flex items-center gap-2">
                        <button type="button" onclick="closeSettingsModal()" class="px-3 py-2 rounded-xl text-slate-500 font-bold text-xs hover:bg-slate-100">取消</button>
                        <button type="submit" class="bg-purple-600 hover:bg-purple-700 text-white font-bold text-xs px-4 py-2 rounded-xl shadow-cute transition-transform active:scale-95">
                            儲存設定
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- 全螢幕聯絡簿 Modal -->
    <div id="homeworkModal" class="fixed inset-0 bg-slate-900/80 backdrop-blur-md z-50 hidden flex flex-col p-4">
        <div class="flex items-center justify-between text-white mb-2">
            <h3 class="text-xl font-bold flex items-center gap-2">
                <span>📖 今日聯絡簿 (全螢幕展示)</span>
            </h3>
            <button onclick="closeHomeworkModal()" class="bg-white/20 hover:bg-white/30 text-white font-bold px-4 py-2 rounded-xl text-sm transition-colors">
                關閉 ✕
            </button>
        </div>
        <div class="flex-1 bg-black rounded-2xl overflow-hidden border-2 border-white/20">
            <iframe src="https://www.canva.com/design/DAHZXg2jrYM/Fe8yVh4EbeHm4UMkCo8i-Q/view?embed" class="w-full h-full border-0" allowfullscreen="allowfullscreen"></iframe>
        </div>
    </div>

    <!-- Toast 通知條 -->
    <div id="toastNotification" class="fixed bottom-6 right-6 bg-slate-900 text-white font-bold text-sm px-5 py-3 rounded-2xl shadow-cute-lg z-50 transform translate-y-20 opacity-0 transition-all duration-300 flex items-center gap-2 border border-slate-700">
        <span id="toastIcon">✨</span>
        <span id="toastMessage">提示訊息</span>
    </div>

    <script>
        // 取得當天日期作為儲存紀錄的 Key (格式: 2026-10-29)
        const getTodayKey = () => {
            const d = new Date();
            return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
        };

        let appState = {
            className: "一年甲班",
            studentCount: 14,
            excludedSeats: [],
            deadline: "07:40",
            exemptSeats: [],
            checkins: {},      // { 1: "07:28" }
            taskCheckins: {}   // { 1: "07:35" }
        };

        window.onload = function() {
            loadFromLocalStorage();
            startClock();
            renderAll();
        };

        function loadFromLocalStorage() {
            const todayKey = getTodayKey();
            const savedSettings = localStorage.getItem('class_helper_config');
            const savedDaily = localStorage.getItem(`class_helper_data_${todayKey}`);

            if (savedSettings) {
                try { Object.assign(appState, JSON.parse(savedSettings)); } catch(e){}
            }
            if (savedDaily) {
                try {
                    const dailyData = JSON.parse(savedDaily);
                    appState.checkins = dailyData.checkins || {};
                    appState.taskCheckins = dailyData.taskCheckins || {};
                } catch(e){}
            }
        }

        function saveToLocalStorage() {
            const todayKey = getTodayKey();
            const config = {
                className: appState.className,
                studentCount: appState.studentCount,
                excludedSeats: appState.excludedSeats,
                deadline: appState.deadline,
                exemptSeats: appState.exemptSeats
            };
            const dailyData = {
                checkins: appState.checkins,
                taskCheckins: appState.taskCheckins
            };

            localStorage.setItem('class_helper_config', JSON.stringify(config));
            localStorage.setItem(`class_helper_data_${todayKey}`, JSON.stringify(dailyData));
        }

        // 時鐘獨立定時器
        function startClock() {
            const updateClock = () => {
                const now = new Date();
                const days = ['日', '一', '二', '三', '四', '五', '六'];
                
                document.getElementById('clockDate').innerText = `${now.getFullYear()}年${String(now.getMonth() + 1).padStart(2, '0')}月${String(now.getDate()).padStart(2, '0')}日 (星期${days[now.getDay()]})`;
                
                const timeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}:${String(now.getSeconds()).padStart(2, '0')}`;
                document.getElementById('clockTime').innerText = timeStr;

                checkDeadlineStatus(String(now.getHours()).padStart(2, '0'), String(now.getMinutes()).padStart(2, '0'));
            };

            updateClock();
            setInterval(updateClock, 1000);
        }

        function checkDeadlineStatus(h, m) {
            const currentTimeStr = `${h}:${m}`;
            const isPassed = currentTimeStr >= appState.deadline;
            const badge = document.getElementById('checkinStatusBadge');

            if (isPassed) {
                badge.innerText = "已截止";
                badge.className = "text-[11px] font-bold px-2 py-0.5 rounded-full bg-rose-100 text-rose-700 border border-rose-200";
            } else {
                badge.innerText = "進行中";
                badge.className = "text-[11px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700 border border-emerald-200";
            }
        }

        function renderAll() {
            document.getElementById('classNameDisplay').innerText = appState.className;
            document.getElementById('deadlineDisplay').innerText = appState.deadline;

            renderMorningSeats();
            renderTaskSeats();
            updateStats();
        }

        // 渲染到校打卡 (左欄，靠底對齊)
        function renderMorningSeats() {
            const grid = document.getElementById('morningSeatsGrid');
            grid.innerHTML = '';

            const now = new Date();
            const currentStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
            const isPassed = currentStr >= appState.deadline;

            for (let i = 1; i <= appState.studentCount; i++) {
                if (appState.excludedSeats.includes(i)) continue;

                const checkTime = appState.checkins[i];
                const isExempt = appState.exemptSeats.includes(i);

                const btn = document.createElement('button');
                btn.className = `seat-btn h-16 rounded-2xl flex flex-col items-center justify-center border-2 transition-all shadow-cute-sm ${
                    isExempt 
                        ? 'bg-sky-50 border-sky-300 text-sky-800 cursor-not-allowed opacity-80'
                        : checkTime
                            ? 'bg-emerald-100 border-emerald-400 text-emerald-900 shadow-pressed cursor-default'
                            : isPassed
                                ? 'bg-slate-100 border-slate-300 text-slate-400 cursor-not-allowed'
                                : 'bg-gradient-to-b from-teal-50 to-emerald-50 hover:from-teal-100 hover:to-emerald-100 border-teal-300 text-teal-900 active:scale-95'
                }`;

                let subHtml = '';
                if (isExempt) {
                    subHtml = `<span class="text-[10px] font-bold text-sky-700">免打卡</span>`;
                } else if (checkTime) {
                    subHtml = `<span class="text-[10px] font-black bg-emerald-200/80 text-emerald-800 px-1 py-0.5 rounded-md leading-none">${checkTime}</span>`;
                } else {
                    subHtml = `<span class="text-[10px] font-medium text-teal-600/70">${isPassed ? '已截止' : '點擊'}</span>`;
                }

                btn.innerHTML = `
                    <span class="text-2xl font-black clock-font leading-none mb-0.5">${i}</span>
                    ${subHtml}
                `;

                if (!isExempt && !checkTime && !isPassed) {
                    btn.onclick = () => handleMorningCheckin(i);
                } else if (checkTime) {
                    btn.onclick = () => showToast(`${i} 號已於 ${checkTime} 完成打卡`, '✅');
                } else if (isExempt) {
                    btn.onclick = () => showToast(`${i} 號今日免打卡`, 'ℹ️');
                } else {
                    btn.onclick = () => showToast(`打卡時間已截止 (${appState.deadline})`, '⏰');
                }

                grid.appendChild(btn);
            }
        }

        function handleMorningCheckin(seatNum) {
            const now = new Date();
            const timeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
            
            appState.checkins[seatNum] = timeStr;
            saveToLocalStorage();
            renderMorningSeats();
            updateStats();

            showToast(`🎉 ${seatNum} 號到校打卡成功！(${timeStr})`, '✨');
        }

        // 渲染打掃與中午打卡 (右欄，靠底對齊)
        function renderTaskSeats() {
            const grid = document.getElementById('taskSeatsGrid');
            grid.innerHTML = '';

            let doneCount = 0;
            let totalActive = 0;

            for (let i = 1; i <= appState.studentCount; i++) {
                if (appState.excludedSeats.includes(i)) continue;
                totalActive++;

                const taskTime = appState.taskCheckins[i];
                if (taskTime) doneCount++;

                const btn = document.createElement('button');
                btn.className = `seat-btn h-16 rounded-2xl flex flex-col items-center justify-center border-2 transition-all shadow-cute-sm ${
                    taskTime 
                        ? 'bg-sky-100 border-sky-400 text-sky-900 shadow-pressed'
                        : 'bg-gradient-to-b from-sky-50 to-blue-50 hover:from-sky-100 hover:to-blue-100 border-sky-300 text-sky-900 active:scale-95'
                }`;

                btn.innerHTML = `
                    <span class="text-2xl font-black clock-font leading-none mb-0.5">${i}</span>
                    <span class="text-[10px] font-bold ${taskTime ? 'text-sky-800 bg-sky-200/80 px-1 py-0.5 rounded-md' : 'text-sky-500'}">
                        ${taskTime ? taskTime : '未完成'}
                    </span>
                `;

                btn.onclick = () => toggleTaskCheckin(i);
                grid.appendChild(btn);
            }

            document.getElementById('taskDoneCount').innerText = `${doneCount}/${totalActive}`;
        }

        function toggleTaskCheckin(seatNum) {
            if (appState.taskCheckins[seatNum]) {
                delete appState.taskCheckins[seatNum];
                showToast(`${seatNum} 號打掃紀錄已重置`, '✏️');
            } else {
                const now = new Date();
                const timeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
                appState.taskCheckins[seatNum] = timeStr;
                showToast(`${seatNum} 號打掃工作/簽到完成！(${timeStr})`, '🧹');
            }
            saveToLocalStorage();
            renderTaskSeats();
        }

        function resetTaskSeats() {
            appState.taskCheckins = {};
            saveToLocalStorage();
            renderTaskSeats();
            showToast('已重置打掃簽到紀錄！', '🔄');
        }

        function updateStats() {
            let totalActive = 0;
            let checkedInCount = 0;

            for (let i = 1; i <= appState.studentCount; i++) {
                if (appState.excludedSeats.includes(i)) continue;
                totalActive++;

                if (appState.exemptSeats.includes(i)) continue;
                if (appState.checkins[i]) checkedInCount++;
            }

            const exemptCount = appState.exemptSeats.filter(s => s <= appState.studentCount && !appState.excludedSeats.includes(s)).length;
            const uncheckedCount = totalActive - checkedInCount - exemptCount;

            document.getElementById('statCheckedIn').innerText = checkedInCount;
            document.getElementById('statUnchecked').innerText = Math.max(0, uncheckedCount);
            document.getElementById('statExempt').innerText = exemptCount;
        }

        function toggleHomeworkMask() {
            const mask = document.getElementById('homeworkMask');
            const btnText = document.getElementById('maskBtnText');
            if (mask.classList.contains('hidden')) {
                mask.classList.remove('hidden');
                btnText.innerText = "顯示聯絡簿";
            } else {
                mask.classList.add('hidden');
                btnText.innerText = "遮蔽聯絡簿";
            }
        }

        function openHomeworkModal() {
            document.getElementById('homeworkModal').classList.remove('hidden');
        }

        function closeHomeworkModal() {
            document.getElementById('homeworkModal').classList.add('hidden');
        }

        function openSettingsModal() {
            document.getElementById('cfgClassName').value = appState.className;
            document.getElementById('cfgStudentCount').value = appState.studentCount;
            document.getElementById('cfgExcludedSeats').value = appState.excludedSeats.join(', ');
            document.getElementById('cfgDeadline').value = appState.deadline;

            renderExemptCheckboxes();
            document.getElementById('settingsModal').classList.remove('hidden');
        }

        function closeSettingsModal() {
            document.getElementById('settingsModal').classList.add('hidden');
        }

        function renderExemptCheckboxes() {
            const container = document.getElementById('exemptCheckboxContainer');
            const count = parseInt(document.getElementById('cfgStudentCount').value) || 14;
            
            let html = '';
            for (let i = 1; i <= count; i++) {
                const isChecked = appState.exemptSeats.includes(i);
                html += `
                    <label class="flex items-center gap-1 cursor-pointer bg-white p-1 rounded-lg border border-slate-200 hover:bg-purple-50">
                        <input type="checkbox" class="exempt-checkbox accent-purple-600 rounded" value="${i}" ${isChecked ? 'checked' : ''}>
                        <span class="font-bold text-slate-700">${i}</span>
                    </label>
                `;
            }
            container.innerHTML = html;
        }

        function saveSettings(e) {
            e.preventDefault();

            appState.className = document.getElementById('cfgClassName').value.trim() || "一年甲班";
            appState.studentCount = parseInt(document.getElementById('cfgStudentCount').value) || 14;
            appState.deadline = document.getElementById('cfgDeadline').value;
            
            const excludedInput = document.getElementById('cfgExcludedSeats').value;
            appState.excludedSeats = excludedInput
                .split(/[,，\s]+/)
                .map(n => parseInt(n))
                .filter(n => !isNaN(n));

            const checkboxes = document.querySelectorAll('.exempt-checkbox:checked');
            appState.exemptSeats = Array.from(checkboxes).map(cb => parseInt(cb.value));

            saveToLocalStorage();
            renderAll();
            closeSettingsModal();

            showToast('設定已更新儲存！', '💾');
        }

        function resetTodayCheckins() {
            appState.checkins = {};
            saveToLocalStorage();
            renderMorningSeats();
            updateStats();
            showToast('已重置今日到校打卡紀錄！', '🧹');
        }

        function showToast(msg, icon = '✨') {
            const toast = document.getElementById('toastNotification');
            document.getElementById('toastMessage').innerText = msg;
            document.getElementById('toastIcon').innerText = icon;

            toast.classList.remove('translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
                toast.classList.remove('translate-y-0', 'opacity-100');
            }, 2000);
        }
    </script>
</body>
</html>
